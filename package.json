  "bugs": {
    "url": "https://github.com/polite0803/AxAgent/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:skip-typecheck": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:build": "node scripts/tauri-build.mjs",
    "tauri:android:init": "tauri android init",
    "tauri:android:dev": "tauri android dev",
    "tauri:android:build": "tauri android build",
    "tauri:ios:init": "tauri ios init",
    "tauri:ios:dev": "tauri ios dev",
    "tauri:ios:build": "tauri ios build",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "bump": "node scripts/bump-version.mjs",
    "format": "dprint fmt",
    "format:check": "dprint check",
    "lint": "tsc --noEmit",
    "check:types": "node scripts/type-consistency.mjs",
    "docs": "typedoc --out docs src",
    "docs:watch": "typedoc --out docs --watch src",
    "ci:check": "node scripts/ci-check.mjs",
    "ci:check:quick": "node scripts/ci-check.mjs --quick",
    "prepare": "simple-git-hooks",
    "skill:create": "node scripts/create-axagent-skill.mjs",
    "skill:validate": "node scripts/validate-skill.mjs"
