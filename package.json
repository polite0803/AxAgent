  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:skip-typecheck": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:build": "node scripts/tauri-build.mjs",
    "build:clean": "node scripts/sccache-clean-build.mjs",
    "tauri:android:init": "tauri android init",
    "tauri:android:dev": "tauri android dev",
    "tauri:android:build": "tauri android build",
    "tauri:ios:init": "tauri ios init",
    "tauri:ios:dev": "tauri ios dev",
    "tauri:ios:build": "tauri ios build",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:integration": "vitest run --config vite.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:rust": "node scripts/cargo-test-win.mjs",
    "bump": "node scripts/bump-version.mjs",
    "format": "dprint fmt",
    "format:check": "dprint check",
    "lint": "tsc --noEmit",
    "lint:eslint": "eslint src --max-warnings=0",
    "check:types": "node scripts/type-consistency.mjs",
    "check:paired": "node scripts/check-paired-fields.ts",
    "check:serde": "tsx scripts/check-serde-annotations.ts",
    "docs": "typedoc --out docs src",
    "docs:watch": "typedoc --out docs --watch src",
    "ci:check": "node scripts/ci-check.mjs",
    "ci:check:quick": "node scripts/ci-check.mjs --quick",
    "contracts": "node scripts/check-contracts.mjs",
    "prepare": "simple-git-hooks",
    "skill:create": "node scripts/create-axagent-skill.mjs",
    "skill:validate": "node scripts/validate-skill.mjs",
    "check:i18n": "python scripts/check_i18n.py",
    "check:i18n:json": "python scripts/check_i18n.py --json"
  },
