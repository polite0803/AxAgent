<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  SPDX-License-Identifier: AGPL-3.0-only
  Common Controls v6 manifest — 嵌入测试二进制，规避 tauri 已知问题
  STATUS_ENTRYPOINT_NOT_FOUND (0xc0000139)：cargo test 生成的 exe 未声明
  comctl32 v6 依赖时，tauri/wry 引用的 v6 入口点找不到。
  参考: https://github.com/tauri-apps/tauri/issues/11028
       https://github.com/tauri-apps/tauri/pull/4383#issuecomment-1212221864
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <dependency>
    <dependentAssembly>
      <assemblyIdentity
        type="win32"
        name="Microsoft.Windows.Common-Controls"
        version="6.0.0.0"
        processorArchitecture="*"
        publicKeyToken="6595b64144ccf1df"
        language="*"
      />
    </dependentAssembly>
  </dependency>
</assembly>
