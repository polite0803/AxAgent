{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": "1.0.0",
  "description": "AxInvest LLM Agent 输出格式强约束 Schema。所有 LLM Agent（trader/research-mgr/catalyst/debate-convergence/risk-level/data-quality）的输出必须通过本 Schema 验证，否则触发 strict_mode 降级。",

  "schemas": {
    "base_event": {
      "description": "事件基础字段（所有事件类 Agent 输出必须绑定此五字段）",
      "type": "object",
      "required": ["Target_Entity", "Event_Type", "Impact_Direction", "Impact_Timeline", "Confidence_Score"],
      "properties": {
        "Target_Entity": {
          "type": "string",
          "minLength": 1,
          "description": "事件影响的目标实体，格式：股票代码或板块名称，如 '300285' 或 '半导体'"
        },
        "Event_Type": {
          "type": "string",
          "minLength": 1,
          "enum": [
            "增持",
            "回购",
            "中标",
            "重大合同",
            "业绩预增",
            "扭亏为盈",
            "减持",
            "业绩预亏",
            "立案调查",
            "监管函",
            "退市风险",
            "产品发布",
            "技术突破",
            "政策利好",
            "评级上调",
            "评级下调",
            "商誉减值",
            "诉讼",
            "违约",
            "并购重组",
            "分红",
            "送转",
            "行业景气",
            "周期性波动",
            "汇率影响",
            "原材料价格",
            "定期报告",
            "股东大会",
            "人事变动",
            "停牌",
            "复牌",
            "其他"
          ],
          "description": "事件类型，必须从枚举中选择最匹配的类型"
        },
        "Impact_Direction": {
          "type": "string",
          "enum": ["Positive", "Negative", "Neutral"],
          "description": "事件对目标实体的影响方向：Positive=利好，Negative=利空，Neutral=中性"
        },
        "Impact_Timeline": {
          "type": "string",
          "enum": ["Immediate", "Short_Term", "Medium_Term", "Long_Term"],
          "description": "事件影响的时间维度：Immediate=即时（T+0~1），Short_Term=短期（1~5日），Medium_Term=中期（1~4周），Long_Term=长期（1月+）"
        },
        "Confidence_Score": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0,
          "description": "LLM 自评可信度（0.0~1.0），<0.4 触发 C 维度自动丢弃（见 pace-calc.rhai）"
        }
      }
    },

    "trader_output": {
      "description": "LLM Trader Agent 输出格式 — 双视角冗余校验的 LLM 视角（V65 升级：与 portfolio-mgr 公式决策同维度对齐）",
      "type": "object",
      "required": [
        "action",
        "verdict",
        "positionPct",
        "confidence",
        "riskLevel",
        "currentPrice",
        "targetPrice",
        "stopLoss",
        "stopLossPct",
        "takeProfitPct",
        "timeHorizon",
        "expectedHoldingDays",
        "evidence_cited",
        "reasoning"
      ],
      "properties": {
        "action": {
          "type": "string",
          "enum": ["买入", "增持", "持有", "观望", "减持", "卖出"],
          "description": "操作指令（与 portfolio-mgr 的 action 同维度，用于双视角对比）"
        },
        "verdict": {
          "type": "string",
          "enum": ["看多", "看空", "中性"],
          "description": "方向结论，必须与 action 严格一致（买入/增持→看多，卖出/减持→看空，持有/观望→中性）"
        },
        "positionPct": {
          "type": "number",
          "minimum": 0,
          "maximum": 95,
          "description": "建议仓位百分比 0-95，必须与 riskLevel 反相关，与 action 匹配"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "本交易员对决策的置信度 0-100（整数）。与 evidence_cited 数量挂钩：≥5 条可达 80-100，3-4 条可达 60-80，<3 条强制 ≤40"
        },
        "riskLevel": {
          "type": "string",
          "enum": ["低风险", "中风险", "高风险", "极高风险"],
          "description": "风险等级（与 portfolio-mgr 的 riskLevel 同维度，用于双视角对比）"
        },
        "currentPrice": {
          "type": "number",
          "minimum": 0.01,
          "description": "当前价（元），优先使用 context 中的 reference_price"
        },
        "targetPrice": {
          "type": "number",
          "minimum": 0.01,
          "description": "目标价（元），与 action/verdict 关系一致（看多→targetPrice > currentPrice×1.05）"
        },
        "stopLoss": {
          "type": "number",
          "minimum": 0.01,
          "description": "止损价（元），必须 > 0"
        },
        "stopLossPct": {
          "type": "number",
          "minimum": 0,
          "maximum": 30,
          "description": "止损百分比（相对 currentPrice），与 timeHorizon 匹配（ultra_short:2-4, short:4-7, mid:6-12, long:10-15）"
        },
        "takeProfitPct": {
          "type": "number",
          "minimum": 0,
          "maximum": 50,
          "description": "止盈百分比（相对 currentPrice），必须 > stopLossPct（盈亏比 > 1）"
        },
        "timeHorizon": {
          "type": "string",
          "enum": ["ultra_short", "short", "mid", "long"],
          "description": "时间视角：ultra_short=1-2天，short=1周，mid=1月，long=3月"
        },
        "expectedHoldingDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 250,
          "description": "预期持有天数（交易日）"
        },
        "data_gaps": {
          "type": "array",
          "items": { "type": "string" },
          "description": "LLM 视角识别到的数据缺口列表（与 portfolio-mgr 的 data_gaps 做 Jaccard 相似度对比）",
          "maxItems": 20
        },
        "evidence_cited": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["source", "point"],
            "properties": {
              "source": {
                "type": "string",
                "description": "上游节点名（如 research-mgr/debate-convergence/risk-convergence/a-catalyst/t-scoring/data-quality）"
              },
              "point": {
                "type": "string",
                "minLength": 5,
                "description": "引用的具体论据（≥5 字符，禁止空话）"
              }
            }
          },
          "minItems": 3,
          "maxItems": 10,
          "description": "强制引用上游论据列表，≥3 条为有效决策，<3 条触发 strict_mode 降级"
        },
        "risk_factors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "severity"],
            "properties": {
              "name": { "type": "string", "minLength": 2 },
              "severity": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
              "probability": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
            }
          },
          "maxItems": 5,
          "description": "关键风险因素列表"
        },
        "decision_trail": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["step", "input", "conclusion"],
            "properties": {
              "step": { "type": "string", "description": "推理步骤名（如方向判断/仓位计算/价位设定）" },
              "input": { "type": "string", "description": "该步骤的输入依据" },
              "conclusion": { "type": "string", "description": "该步骤的结论" }
            }
          },
          "maxItems": 10,
          "description": "LLM 推理链（与 portfolio-mgr 的 decision_trail 做结构对比）"
        },
        "lessons_applied": {
          "type": "array",
          "items": { "type": "string" },
          "description": "本次方案吸取的历史教训列表（来自 stock_lessons）",
          "maxItems": 5
        },
        "reasoning": {
          "type": "string",
          "minLength": 50,
          "description": "完整推理过程，必须引用 ≥3 个上游节点的具体论据，禁止空话"
        }
      }
    },

    "catalyst_output": {
      "description": "LLM Catalyst Agent 输出格式（与 catalyst-analyst.md 及 seed a-catalyst 强制约束保持一致）",
      "type": "object",
      "required": [
        "report",
        "catalyst_level",
        "institutional_trace",
        "narrative_completeness",
        "confidence",
        "reasoning"
      ],
      "properties": {
        "report": {
          "type": "string",
          "description": "完整分析报告文本（自然语言，可含结构化分析）"
        },
        "catalyst_level": {
          "type": "string",
          "enum": [
            "L3估值体系级",
            "L2业绩拐点级",
            "L1普通消息",
            "无",
            "L-1普通利空",
            "L-2业绩暴雷级",
            "L-3退市造假级"
          ],
          "description": "催化剂强度等级（与 prompt 枚举一致，无连字符）"
        },
        "institutional_trace": {
          "type": "string",
          "enum": ["无", "疑似建仓", "有建仓痕迹", "明显建仓"],
          "description": "机构资金布局痕迹"
        },
        "narrative_completeness": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "叙事完整度评分 0-100"
        },
        "confidence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "description": "置信度评分 0-100"
        },
        "reasoning": {
          "type": "string",
          "description": "简短的推理过程摘要"
        }
      }
    },

    "risk_output": {
      "description": "LLM Risk Level Agent 输出格式",
      "type": "object",
      "required": ["category", "risk_factors"],
      "properties": {
        "category": {
          "type": "string",
          "enum": ["低风险", "中风险", "高风险", "极高风险"],
          "description": "综合风险等级"
        },
        "risk_factors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["Target_Entity", "Event_Type", "Impact_Direction", "Confidence_Score"],
            "properties": {
              "Target_Entity": { "type": "string" },
              "Event_Type": { "type": "string" },
              "Impact_Direction": { "type": "string", "enum": ["Positive", "Negative", "Neutral"] },
              "Confidence_Score": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
              "Impact_Timeline": { "type": "string", "enum": ["Immediate", "Short_Term", "Medium_Term", "Long_Term"] }
            }
          }
        }
      }
    }
  },

  "validation_rules": {
    "strict_mode_threshold": {
      "description": "任一必填字段缺失或类型不匹配 → 触发 strict_mode 降级，agent_executor 注入 __untrusted=true",
      "enabled": true
    },
    "backward_compatibility": {
      "description": "V65: targetPrice/stopLoss 恢复为必填字段（双视角对比需要价位维度）；direction 字段被 verdict 取代",
      "deprecated_fields": ["direction"],
      "grace_period": "2026-09-01"
    },
    "trader_strict_mode_rules": {
      "description": "trader 节点 strict_mode 校验规则（违反任一规则注入 __untrusted=true）",
      "rules": [
        "action 与 verdict 严格一致（买入/增持→看多，卖出/减持→看空，持有/观望→中性）",
        "action 与 targetPrice/currentPrice 关系一致",
        "positionPct 与 riskLevel 反相关（极高风险≤10，高风险≤35，中风险≤50，低风险≤95）",
        "positionPct 与 action 匹配（买入≥15，增持≥10，观望/卖出=0，减持≤15）",
        "stopLossPct 与 timeHorizon 匹配（ultra_short:2-4, short:4-7, mid:6-12, long:10-15）",
        "takeProfitPct > stopLossPct",
        "stopLoss > 0",
        "evidence_cited 数量 ≥ 3",
        "confidence 与 evidence_cited 数量挂钩（<3 条→confidence≤40）"
      ]
    },
    "event_type_enum_loose": {
      "description": "Event_Type 枚举允许 '其他' 兜底，但若 '其他' 占比 > 30% 触发数据质量警告",
      "other_ratio_threshold": 0.30
    }
  }
}
