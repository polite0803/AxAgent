{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AxAgent",
  "version": "2.8.0",
  "identifier": "top.axagent.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self' https://tauri.localhost tauri: ipc:; script-src 'self' https://tauri.localhost tauri: ipc:; style-src 'self' 'unsafe-inline' https://tauri.localhost tauri: ipc:; img-src 'self' data: https: asset:; connect-src 'self' https://tauri.localhost tauri: ipc: https://api.openai.com https://api.anthropic.com https://generativelanguage.googleapis.com https://api.openclaw.ai http://localhost:* http://127.0.0.1:*; frame-src 'self'; object-src 'none'; base-uri 'self';"
    },
    "windows": [
      {
        "title": "AxAgent",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "visible": true,
        "focus": true,
        "useHttpsScheme": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "pricing.toml"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "active": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU0OThDNDAyMUU5OTQwNTcKUldSWFFKa2VBc1NZVkZlU2lBTS8wU1pqUFFuODhKNUFzd3owZFNlTUFXelJXM1VBNndmN2hKQ0cK",
      "endpoints": [],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
