  "trae.chatLanguage": "cn",
  "openclaw.chat.dimension": "1x1",
  "openclaw.chat.agent": "opencode",
  "chat.viewSessions.orientation": "stacked",

  // ===== GitHub Copilot 核心能力优化（新增） =====

  // 1. Agent 模式增强 - 接近 Claude Code 的自主执行能力
  "github.copilot.chat.agent.thinkingTool": true,
  "chat.agent.thinking.collapsedTools": "always",
  "chat.agent.thinking.budgetTokens": 32768,
  "chat.agent.effort": "max",
  "chat.agent.maxRequests": 500,
  "chat.agent.maxParallelTools": 16,
  "chat.useAgentSkills": true,
  "chat.useCustomAgentHooks": true,
  "github.copilot.chat.summarizeAgentConversationHistory.enabled": true,
  "github.copilot.chat.agent.mode": "agent",
  "github.copilot.chat.agent.autoApprove": "read",
  "github.copilot.chat.agent.maxWorkspaceFiles": 50,
  "github.copilot.chat.agent.terminalAccess": true,

  // 2. 代码补全优化
  "github.copilot.inlineSuggest.enable": true,
  "editor.inlineSuggest.enabled": true,
  "github.copilot.enable": {
    "*": true,
    "plaintext": false,
    "markdown": true
  },

  // 3. 代码生成指令 - 让 Copilot 遵循工程规范
  "github.copilot.chat.codeGeneration.instructions": [
    {
      "text": "Always follow existing code patterns, naming conventions, and project structure. Do not introduce unnecessary new dependencies."
    },
    {
      "text": "Write clean, modular code with proper error handling. Prefer composition over inheritance. Keep functions small and focused (under 50 lines)."
    },
    {
      "text": "When modifying files, make minimal, precise changes. Do not rewrite unrelated code. Preserve existing formatting and style."
    },
    {
      "text": "If a file exceeds 500 lines, consider splitting into smaller modules. Prefer creating new files over bloating existing ones."
    },
    {
      "text": "Always add type annotations where the language supports it (TypeScript, Python type hints, Java generics)."
    },
    {
      "text": "When generating code, include brief comments for complex logic but avoid obvious comments. Follow DRY and SOLID principles."
    },
    {
      "text": "For frontend: use semantic HTML, follow accessibility best practices, prefer CSS modules or Tailwind utility classes over inline styles."
    },
    {
      "text": "For backend: validate all inputs, use proper HTTP status codes, implement proper error responses with meaningful messages."
    }
  ],
  "github.copilot.chat.testGeneration.instructions": [
    {
      "text": "Generate tests that cover edge cases and error scenarios, not just happy paths."
    },
    {
      "text": "Use the project's existing test framework and patterns. Place test files in the conventional location."
    },
    {
      "text": "After code changes, always run relevant tests to verify correctness before considering the task done."
    }
  ],

  // 4. 上下文感知优化
  "github.copilot.editorContext.enabled": true,
  "github.copilot.editorContext.maxWorkspaceFiles": 50,

  // 5. 安全与隐私
  "github.copilot.advanced.allowClipboardAccess": false,

  // 6. Chat 面板优化
  "github.copilot.chat.showNaturalLanguageExplanations": false,
  "github.copilot.chat.codeBlockAccessibilityAnnouncements": false,
  "github.copilot.chat.responseLanguage": "chinese",

  // 7. Plan 模式 - 复杂任务先规划再执行（类似 Claude Code 的 plan-then-execute）
  "github.copilot.chat.planMode.enabled": true,

  // 8. 文件排除 - 避免噪音上下文
  "github.copilot.chat.excludedFiles": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/.git/**",
    "**/package-lock.json",
    "**/yarn.lock",
    "**/pnpm-lock.yaml",
    "**/*.min.js",
    "**/*.min.css",
    "**/*.map",
    "**/.next/**",
    "**/coverage/**"
  ],

  // 9. 编辑器辅助 - 提升交互效率
  "editor.suggestSelection": "recentlyUsedByPrefix",
  "editor.wordBasedSuggestions": "off",
  "editor.acceptSuggestionOnCommitCharacter": false,
  "editor.tabCompletion": "on",
  "editor.parameterHints.cycle": true,

  // 10. 无障碍精简
  "accessibility.verboseChatProgressUpdates": false,
  "accessibility.verbosity.panelChat": false,
  "accessibility.verbosity.inlineChat": false,

  // 11. 原有配置保留
  "oaicopilot.commitLanguage": "Chinese (Simplified)"
}
