{
  "manifest_version": 3,
  "name": "AxAgent Wiki Clipper",
  "version": "1.0.0",
  "description": "Clip web pages to your AxAgent LLM Wiki",
  "author": "刘小平",
  "permissions": [
    "activeTab",
    "storage",
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://localhost/*",
    "https://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://localhost/*", "https://localhost/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icons/icon128.svg"
    }
  },
  "icons": {
    "128": "icons/icon128.svg"
  }
}
