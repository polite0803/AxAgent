**Step 2：实现 trace_id middleware**

```rust
// core/src/tracing_ext.rs
pub async fn trace_id_middleware(mut request: Request<Body>, next: Next) -> Response {
    let trace_id = request.headers()
        .get("x-trace-id")
        .and_then(|v| v.to_str().ok())
        .map(String::from)
        .unwrap_or_else(|| Uuid::new_v4().to_string());

    let span = tracing::info_span!("request", trace_id = %trace_id);
    let _guard = span.enter();
    let mut response = next.run(request).await;
    response.headers_mut().insert("x-trace-id", HeaderValue::from_str(&trace_id).unwrap());
    response
}
```

**Step 3：Tauri command 层 trace_id 注入**

```rust
async fn invoke_with_trace<F, T>(cmd: &str, fut: F) -> Result<T, String>
where F: Future<Output = Result<T, String>>
{
    let trace_id = Uuid::new_v4().to_string();
    let span = tracing::info_span!("tauri_command", cmd = %cmd, trace_id = %trace_id);
    let _guard = span.enter();
    fut.await
}
```

