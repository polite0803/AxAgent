```rust
// auth.rs
use std::collections::HashMap;
use std::sync::Arc;
use std::time::{Duration, Instant};
use tokio::sync::Mutex;

pub struct KeyVerifyLimiter {
    failures: Arc<Mutex<HashMap<String, (u32, Instant)>>>,
    max_failures: u32,
    cooldown: Duration,
}

impl KeyVerifyLimiter {
    pub fn new(max_failures: u32, cooldown: Duration) -> Self {
        Self { failures: Arc::new(Mutex::new(HashMap::new())), max_failures, cooldown }
    }

    pub async fn check(&self, ip: &str) -> bool {
        let mut map = self.failures.lock().await;
        if let Some((count, last)) = map.get(ip) {
            if last.elapsed() < self.cooldown && *count >= self.max_failures {
                return false;
            }
        }
        true
    }

    pub async fn record_failure(&self, ip: &str) {
        let mut map = self.failures.lock().await;
        let entry = map.entry(ip.to_string()).or_insert((0, Instant::now()));
        entry.0 += 1;
        entry.1 = Instant::now();
    }

    pub async fn record_success(&self, ip: &str) {
        self.failures.lock().await.remove(ip);
    }
}
```

