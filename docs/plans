// realtime.rs
#[derive(Deserialize)]
pub struct RealtimeQuery {
    ticket: Option<String>,
}

pub async fn realtime_handler(
    State(state): State<GatewayAppState>,
    Extension(ticket_store): Extension<Arc<TicketStore>>,
    Query(params): Query<RealtimeQuery>,
    ws: WebSocketUpgrade,
) -> Response {
    let ticket_id = match params.ticket {
        Some(t) if !t.is_empty() => t,
        _ => return unauth("Missing ticket parameter"),
    };
    let ticket = match ticket_store.consume(&ticket_id).await {
        Some(t) => t,
        None => return unauth("Invalid or expired ticket"),
    };
    // ticket.key_id 即原 key.id，验证它仍然有效
    match state.adapter.gateway_keys().get_by_id(&ticket.key_id).await {
        Ok(Some(key)) if key.enabled => {
            // 升级 WS
            ws.on_upgrade(move |socket| handle_realtime_session(socket, state.db))
        }
        _ => unauth("API key disabled"),
    }
}
