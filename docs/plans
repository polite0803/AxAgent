**Step 2：实现启动期重加密**

```rust
// crypto/src/migration.rs
pub async fn reencrypt_v1_to_v2(
    db: &DatabaseConnection,
    master_key: &[u8; 32],
) -> Result<u32, AxAgentError> {
    // 找出所有 kdf_version = 1 的密钥
    let v1_keys: Vec<Entity> = ProviderKey::find()
        .filter(provider_key::Column::KdfVersion.eq(1))
        .all(db).await?;
    let mut count = 0;
    for key in v1_keys {
        let plaintext = decrypt_v1(&key.key_encrypted, master_key)?;
        let new_payload = encrypt_v2(&plaintext, master_key)?;
        let mut active: ActiveModel = key.into();
        active.key_encrypted = Set(new_payload);
        active.kdf_version = Set(2);
        active.update(db).await?;
        count += 1;
    }
    Ok(count)
}
```

**Step 3：在 init/database.rs 启动时调用**

