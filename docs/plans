use tokio::process::Command as TokioCommand;

// ... 在 call() 内部 ...

let mut child = TokioCommand::new(shell)
    .arg(flag)
    .arg(cmd)
    .current_dir(working_dir)
    .stdout(std::process::Stdio::piped())
    .stderr(std::process::Stdio::piped())
    .stdin(std::process::Stdio::null())
    .kill_on_drop(true)  // 关键：Drop 时自动 kill
    .spawn()
    .await
    .map_err(|e| ToolError::execution_failed_for("Bash", format!("启动命令失败: {}", e)))?;

let start = std::time::Instant::now();

// tokio::time::timeout 包装 wait，等待 stdout/stderr
let output = tokio::time::timeout(
    std::time::Duration::from_secs(timeout_secs),
    async {
        let out = child.wait_with_output().await?;
        Ok::<_, std::io::Error>(out)
    }
).await;

let elapsed = start.elapsed();
let output = match output {
    Ok(Ok(o)) => o,
    Ok(Err(e)) => return Err(ToolError::execution_failed_for("Bash", format!("命令执行异常: {}", e))),
    Err(_) => {
        // timeout：child 已通过 kill_on_drop 终止
        return Err(ToolError {
            error_code: "tool.Bash.timeout".into(),
            message: format!("命令执行超时（{} 秒）", timeout_secs),
            kind: crate::ToolErrorKind::Timeout,
        });
    }
};

let stdout = String::from_utf8_lossy(&output.stdout);
let stderr = String::from_utf8_lossy(&output.stderr);

let stdout_display = if stdout.len() > MAX_OUTPUT_BYTES {
    format!("{}\n\n[stdout 已截断，显示 {}/{} 字节]", &stdout[..MAX_OUTPUT_BYTES], MAX_OUTPUT_BYTES, stdout.len())
} else {
    stdout.to_string()
};
let stderr_display = if stderr.is_empty() {
    String::new()
} else if stderr.len() > MAX_OUTPUT_BYTES / 2 {
    format!("\n\n## stderr\n{}\n[已截断]", &stderr[..MAX_OUTPUT_BYTES / 2])
} else {
    format!("\n\n## stderr\n{}", stderr)
};

let mut result = String::new();
result.push_str(&format!(
    "## 退出码: {}\n耗时: {:.1}s\n\n",
    output.status.code().unwrap_or(-1),
    elapsed.as_secs_f64()
));
if !stdout_display.is_empty() { result.push_str(&stdout_display); }
if !stderr_display.is_empty() { result.push_str(&stderr_display); }

return Ok(ToolResult::success(result));
```

