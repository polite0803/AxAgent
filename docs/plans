// sandbox.rs
fn build_native_command(&self, cmd: &str, working_dir: &str) -> Command {
    let mut command = Command::new("bash");
    command.arg("-c").arg(cmd);
    command.current_dir(working_dir);

    // 安全：清除所有继承的环境变量，仅保留白名单
    command.env_clear();
    command.env("PATH", "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin");
    command.env("HOME", "/tmp");  // 沙箱 HOME
    command.env("TMPDIR", "/tmp");
    command.env("LANG", "C.UTF-8");

    // 资源限制（如果支持）
    #[cfg(unix)]
    unsafe {
        // AS 256MB, CPU 60s, NOFILE 1024
        let _ = libc::setrlimit(libc::RLIMIT_AS, &libc::rlimit { rlim_cur: 256*1024*1024, rlim_max: 256*1024*1024 });
        let _ = libc::setrlimit(libc::RLIMIT_CPU, &libc::rlimit { rlim_cur: 60, rlim_max: 60 });
        let _ = libc::setrlimit(libc::RLIMIT_NOFILE, &libc::rlimit { rlim_cur: 1024, rlim_max: 1024 });
    }

    // 注入 safe bash flags
    let safe_cmd = format!("set -euo pipefail; {}", cmd);
    command.arg("-c").arg(safe_cmd);

    command
}
```

