// migrations/mod.rs
use sea_orm::{ConnectionTrait, DbErr, Statement, DatabaseBackend};
use sea_orm::TransactionTrait;

pub mod v001_initial;
pub mod v002_indices;
pub mod v003_drop_dead_tables;

const MIGRATIONS: &[(&str, &str, fn(&sea_orm::Schema, &mut sea_orm::TableCreateStatement))] = &[
    // 简化为函数指针数组
];

pub async fn run_migrations(db: &sea_orm::DatabaseConnection) -> Result<(), DbErr> {
    db.execute_unprepared(
        "CREATE TABLE IF NOT EXISTS axagent_schema_version (\
         version INTEGER NOT NULL PRIMARY KEY,\
         applied_at INTEGER NOT NULL\
         )"
    ).await?;

    let current: Option<i32> = db.query_one(Statement::from_string(
        DatabaseBackend::Sqlite, "SELECT MAX(version) FROM axagent_schema_version"
    )).await?.and_then(|r| r.try_get_by::<i32>("MAX(version)").ok());

    let current = current.unwrap_or(0);
    if current < 1 { v001_initial::up(db).await?; record(db, 1).await?; }
    if current < 2 { v002_indices::up(db).await?; record(db, 2).await?; }
    if current < 3 { v003_drop_dead_tables::up(db).await?; record(db, 3).await?; }
    Ok(())
}

async fn record(db: &sea_orm::DatabaseConnection, v: i32) -> Result<(), DbErr> {
    db.execute_unprepared(&format!(
        "INSERT INTO axagent_schema_version(version, applied_at) VALUES({}, {})",
        v, chrono::Utc::now().timestamp()
    )).await
}
